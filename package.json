{
  "name": "aulink",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "@expo/metro-config": {
      "lightningcss": "1.30.1"
    }
  },
  "scripts": {
    "dev:web": "bun run --filter aulink-web dev",
    "dev:mobile": "bun run --filter aulink-mobile start",
    "dev:android": "bun run --filter aulink-mobile android",
    "dev:ios": "bun run --filter aulink-mobile ios",
    "dev:mobile:web": "bun run --filter aulink-mobile web",
    "build:android": "bun run --filter aulink-mobile build:android",
    "build:web": "bun run --filter aulink-web build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "check:monorepo": "bun test scripts/monorepo.test.ts",
    "check:nativewind": "bun test scripts/nativewind.test.ts"
  }
}
